# Copie para apps/api/.env e ajuste. Nunca versione o .env real.
NODE_ENV=development
PORT=3333
# Segredo para assinar a sessão (mínimo 32 caracteres). Troque em produção.
SESSION_SECRET=dev-only-secret-change-me-please-32chars
# Caminho do banco SQLite (relativo a apps/api)
DATABASE_PATH=./data/role.db
# Pasta de comprovantes e notas fiscais (fora da raiz pública)
UPLOAD_DIR=./uploads
# Em desenvolvimento, devolve o código OTP na resposta para facilitar testes
OTP_DEV_ECHO=true
# URL pública do app web, usada nos links de convite
PUBLIC_WEB_URL=http://localhost:5173
