{
  "name": "operacao-role",
  "private": true,
  "version": "0.1.0",
  "description": "Operação Rolê — organização de rolês em grupo por massa crítica, sinal e rateio justo",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w @role/api\" \"npm run dev -w @role/web\"",
    "build": "npm run build -w @role/api && npm run build -w @role/web",
    "start": "npm run start -w @role/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate -w @role/api",
    "db:seed": "npm run db:seed -w @role/api",
    "metrics": "npm run metrics -w @role/api --silent --",
    "errors": "npm run errors -w @role/api --silent --",
    "backup": "npm run backup -w @role/api --silent --",
    "e2e": "npm run e2e -w @role/web",
    "loadtest": "npm run loadtest -w @role/api --",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
